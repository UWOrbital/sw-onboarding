# DO NOT EDIT THIS FILE DIRECTLY!!
# A copy of this file is created when the setup script ``setup.sh`` is run.
GS_DATABASE_USER=onboarding
GS_DATABASE_PASSWORD=onboarding
GS_DATABASE_LOCATION=localhost
GS_DATABASE_PORT=5433
GS_DATABASE_NAME=sw_onboarding

# Lists are JSON arrays, which is the form pydantic-settings parses into a list[str] field.
# The origins are where the Vite dev server serves the frontend from.
CORS_ALLOW_ORIGINS=["http://localhost:5175","http://127.0.0.1:5175"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHOD=["*"]
CORS_ALLOW_HEADERS=["*"]
